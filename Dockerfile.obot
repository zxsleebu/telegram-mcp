# Telegram MCP + Caddy (Host rewrite) in one container for Obot (containerized runtime).
# Build context = repo root of your fork of chigwell/telegram-mcp.
FROM caddy:2-alpine AS caddybin

# Debian-slim, not Alpine: cryptg has no musl wheels and Telethon cannot find
# libssl via ctypes on Alpine, so media decryption fell back to pure-Python AES
# (~100-200 KB/s) and download_media hit the 55 s tool timeout on ~10 MB files.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TRANSPORT=http \
    MCP_HOST=127.0.0.1 \
    MCP_PORT=8765 \
    XDG_CONFIG_HOME=/app/.caddy \
    XDG_DATA_HOME=/app/.caddy

WORKDIR /app

COPY --from=caddybin /usr/bin/caddy /usr/local/bin/caddy

COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt cryptg && \
    python -c "import cryptg"

COPY main.py sanitize.py ./
COPY telegram_mcp ./telegram_mcp
COPY obot/Caddyfile /etc/caddy/Caddyfile
COPY obot/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh && \
    useradd -m -u 1000 appuser && \
    mkdir -p /app/.caddy /app/data/transcripts && \
    chown -R appuser:appuser /app

USER appuser
EXPOSE 8080
CMD ["/usr/local/bin/entrypoint.sh"]
